.SUFFIXES :
.SUFFIXES : .v .sv .wlf

all: uart_test.wlf

align = ALIGN_4B

.sv.wlf:
	vlog.exe  -f uart_rtl.list -sv +acc=rn +define+${align}+
	vlog.exe  -f uart_be.list  -sv +acc=rn +define+${align}+
	vsim.exe  -i +access +r top < modelSim.in
	mv   transcript  ./uart_test_${align}.log
	mv   vsim.wlf  $*.wlf

work:
	vlib.exe work

clean:
	- \rm -rf  *.bak *~

clean_all:
	- \rm -rf ./work *.wlf  *.diff_log *.dump ./DUMP/*.dump ./DUMP_GATE/*.dump ./LOG/*.log *.log ./obj_dir
	${MAKE} clean

diff:
	diff -q  ./DUMP ./EXP > ${TEST_CONDITION}_diff.log


